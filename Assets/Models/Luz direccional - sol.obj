# Modelo 3D de un Sol/Estrella simple
# Vértices centrales (para dar volumen 3D)
v 0.0 0.0 0.5
v 0.0 0.0 -0.5

# Vértices de las puntas y los valles del sol
v 0.0 2.0 0.0
v 0.5 0.5 0.0
v 2.0 0.0 0.0
v 0.5 -0.5 0.0
v 0.0 -2.0 0.0
v -0.5 -0.5 0.0
v -2.0 0.0 0.0
v -0.5 0.5 0.0

# Caras superiores (conectan el centro superior con las puntas)
f 1 3 4
f 1 4 5
f 1 5 6
f 1 6 7
f 1 7 8
f 1 8 9
f 1 9 10
f 1 10 3

# Caras inferiores (conectan el centro inferior con las puntas)
f 2 4 3
f 2 5 4
f 2 6 5
f 2 7 6
f 2 8 7
f 2 9 8
f 2 10 9
f 2 3 10